{
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/compile.py --trigger session-end >/dev/null 2>&1",
          "timeout": 30
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/compile.py --trigger pre-compact >/dev/null 2>&1",
          "timeout": 30
        }
      ]
    }
  ]
}
